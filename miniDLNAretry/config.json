{
    "name": "miniDLNA for Home Assistant (HA) trial",
    "version": "0.0.0a",
    "slug": "minidlna",
    "description": "This app (~addon) provides you with the latest miniDLNA on Alpine...",
    "url": "https://github.com/Moozzuzz/Apps4HA/tree/main/miniDLNA",
    "startup": "services",
    "boot": "auto",
    "init": "false",
    "arch": ["armhf", "armv7", "aarch64", "amd64", "i386"],
    "ports": {
              "1900/udp": 1900
             },	
    "map": ["config:rw", "ssl:rw", "addons:rw", "share:rw", "backup:rw", "media:rw"],
    "privileged": [
      "NET_ADMIN"
    ],
    "devices": [
      "/dev/net/tun"
    ],
    "host_network": true,
    "options": {
      "media_dir": "/media;/share",
      "options": "-d",
      "friendly_name": MyminiDLNA
    },
    "schema": {
      "media_dir": "str",
      "options": "str",
      "friendly_name": str
    },
        "ingress_port": 9998,
	"webui": "http://[HOST]:[PORT:9998]",
	"ingress": true,

    "panel_icon": "mdi:dlna",
    "panel_title": "miniDLNA"
}
